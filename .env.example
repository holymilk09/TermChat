# Database
DATABASE_URL=postgres://termchat:termchat_dev@localhost:5432/termchat

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-secret-change-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=termchat
S3_SECRET_KEY=termchat_dev
S3_BUCKET=termchat-uploads

# OpenClaw Gateway
OPENCLAW_GATEWAY=ws://127.0.0.1:18789

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
